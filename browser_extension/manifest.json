{
  "manifest_version": 3,
  "name": "SDP Website Discovery",
  "version": "1.0.0",
  "description": "Opt-in discovery of website origins for the local SDP AIOps platform.",
  "permissions": [
    "webNavigation",
    "storage",
    "scripting"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5001/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SDP Website Discovery",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}
